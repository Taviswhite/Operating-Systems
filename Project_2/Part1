#include  <stdio.h>
#include  <stdlib.h>
#include  <sys/types.h>
#include  <sys/ipc.h>
#include  <sys/shm.h>
#include  <unistd.h>
#include  <sys/wait.h>
#include  <time.h>
#include  <signal.h>
#include  <fcntl.h>
#include  <semaphore.h>

void  DearOldDad(int []);
void  LovableMom(int []);
void  ClientProcess(int []);       /* Poor Student */

int    ShmID;
int   *ShmPTR;                      /* ShmPTR[0] = BankAccount */
sem_t *mutex;                       /* protects BankAccount */
char   semName[64];

/* A kill signal (or Ctrl-C) sent to the parent stops every process */
void  Shutdown(int sig)
{
     (void) sig;
     signal(SIGTERM, SIG_IGN);
     kill(0, SIGTERM);              /* stop Mom and the Students */
     while (wait(NULL) > 0)
          ;
     sem_close(mutex);
     sem_unlink(semName);
     shmdt((void *) ShmPTR);
     shmctl(ShmID, IPC_RMID, NULL);
     exit(0);
}

int  main(int  argc, char *argv[])
{
     pid_t  pid;
     int    parents  = 1;           /* 1 = Dad only, 2 = Dad and Mom */
     int    students = 1;           /* number of Poor Students */
     int    i;

     if (argc >= 3) {
          parents  = atoi(argv[1]);
          students = atoi(argv[2]);
     }
     if (parents < 1)  parents = 1;
     if (parents > 2)  parents = 2;
     if (students < 1) students = 1;

     setvbuf(stdout, NULL, _IONBF, 0);   /* keep output in order */

     ShmID = shmget(IPC_PRIVATE, sizeof(int), IPC_CREAT | 0666);
     if (ShmID < 0) {
          printf("*** shmget error (server) ***\n");
          exit(1);
     }

     ShmPTR = (int *) shmat(ShmID, NULL, 0);
     if (ShmPTR == (int *) -1) {
          printf("*** shmat error (server) ***\n");
          exit(1);
     }

     ShmPTR[0] = 0;                 /* BankAccount starts at $0 */

     /* Semaphore with initial value 1 for mutual exclusion */
     snprintf(semName, sizeof(semName), "/psdd_mutex_%d", getpid());
     mutex = sem_open(semName, O_CREAT | O_EXCL, 0644, 1);
     if (mutex == SEM_FAILED) {
          printf("*** sem_open error (server) ***\n");
          exit(1);
     }

     signal(SIGINT,  Shutdown);
     signal(SIGTERM, Shutdown);

     /* Lovable Mom */
     if (parents == 2) {
          pid = fork();
          if (pid < 0) {
               printf("*** fork error (server) ***\n");
               exit(1);
          }
          else if (pid == 0) {
               signal(SIGINT,  SIG_DFL);
               signal(SIGTERM, SIG_DFL);
               LovableMom(ShmPTR);
               exit(0);
          }
     }

     /* Poor Student(s) */
     for (i = 0; i < students; i++) {
          pid = fork();
          if (pid < 0) {
               printf("*** fork error (server) ***\n");
               exit(1);
          }
          else if (pid == 0) {
               signal(SIGINT,  SIG_DFL);
               signal(SIGTERM, SIG_DFL);
               ClientProcess(ShmPTR);
               exit(0);
          }
     }

     /* The parent process is Dear Old Dad */
     DearOldDad(ShmPTR);
     return 0;
}

void  DearOldDad(int  SharedMem[])
{
     int localBalance = 0, amount;
     srand(time(NULL) ^ getpid());

     while (1) {
          sleep(rand() % 6);                        /* 0 - 5 seconds */
          printf("Dear Old Dad: Attempting to Check Balance\n");

          if (rand() % 2 == 0) {
               if (localBalance < 100) {
                    /* Deposit Money */
                    sem_wait(mutex);
                    localBalance = SharedMem[0];
                    amount = rand() % 101;          /* 0 - 100 */
                    if (amount % 2 == 0) {
                         localBalance += amount;
                         printf("Dear old Dad: Deposits $%d / Balance = $%d\n", amount, localBalance);
                         SharedMem[0] = localBalance;
                    }
                    else {
                         printf("Dear old Dad: Doesn't have any money to give\n");
                    }
                    sem_post(mutex);
               }
               else {
                    printf("Dear old Dad: Thinks Student has enough Cash ($%d)\n", localBalance);
               }
          }
          else {
               printf("Dear Old Dad: Last Checking Balance = $%d\n", localBalance);
          }
     }
}

void  LovableMom(int  SharedMem[])
{
     int localBalance = 0, amount;
     srand(time(NULL) ^ (getpid() << 4));

     while (1) {
          sleep(rand() % 11);                       /* 0 - 10 seconds */
          printf("Loveable Mom: Attempting to Check Balance\n");

          if (localBalance <= 100) {
               /* Deposit Money */
               sem_wait(mutex);
               localBalance = SharedMem[0];
               amount = rand() % 126;               /* 0 - 125 */
               localBalance += amount;
               printf("Lovable Mom: Deposits $%d / Balance = $%d\n", amount, localBalance);
               SharedMem[0] = localBalance;
               sem_post(mutex);
          }
     }
}

void  ClientProcess(int  SharedMem[])
{
     int localBalance = 0, need;
     srand(time(NULL) ^ (getpid() << 8));

     while (1) {
          sleep(rand() % 6);                        /* 0 - 5 seconds */
          printf("Poor Student: Attempting to Check Balance\n");

          if (rand() % 2 == 0) {
               /* Withdraw Money */
               sem_wait(mutex);
               localBalance = SharedMem[0];
               need = rand() % 51;                  /* 0 - 50 */
               printf("Poor Student needs $%d\n", need);
               if (need <= localBalance) {
                    localBalance -= need;
                    printf("Poor Student: Withdraws $%d / Balance = $%d\n", need, localBalance);
               }
               else {
                    printf("Poor Student: Not Enough Cash ($%d)\n", localBalance);
               }
               SharedMem[0] = localBalance;
               sem_post(mutex);
          }
          else {
               printf("Poor Student: Last Checking Balance = $%d\n", localBalance);
          }
     }
}
